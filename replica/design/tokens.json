    "accent_role": "a blue primary button (Register), plus pink 'opens a panel' buttons and a green toggle pill. The clone folds these into accent, accent-soft and neutral",
    "type": "Arial 13px for UI, monospace 16px for the editor and body; no type scale",
    "radius": "0, 3, 4 and 5px; no shadows",
    "layout": "fixed 908px editor column + 220px right sidebar, not responsive; palette buttons 29px square"
  },
